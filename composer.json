{
    "name": "aurban-itc/omniwrite",
    "description": "Mandantenfähige Blog-Automation: KI-Entwurf, Review-Mail, SEO/GEO",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "OmniWrite\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "OmniWrite\\Tests\\": "tests/" }
    },
    "scripts": {
        "lint": "find src public bin config tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "test": "phpunit",
        "migrate": "php bin/migrate.php"
    },
    "config": { "sort-packages": true }
}
